# ─── Required ────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — use a long random string
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated emails that receive the Admin Control button.
ADMIN_EMAILS=admin@example.com,owner@example.com
# Temporary: email verification is disabled by default. Set false to re-enable it.
DISABLE_EMAIL_VERIFICATION=true

# ─── Email (Nodemailer / Gmail) ───────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# ─── AI Assistant (optional) ─────────────────────────────────
GROQ_API_KEY=your-groq-api-key
# Optional Groq model override; the bot uses a supported Llama model by default.
GROQ_MODEL=llama-3.3-70b-versatile

# ─── M-Pesa (optional) ───────────────────────────────────────
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-railway-domain.up.railway.app/api/payments/mpesa-callback

# ─── WhatsApp Bot (optional) ─────────────────────────────────
WHATSAPP_BOT_ENABLED=false
WHATSAPP_PHONE_NUMBER=254xxxxxxxxx

# ─── App Config ──────────────────────────────────────────────
NODE_ENV=production
PORT=8080
ALLOWED_ORIGINS=https://your-railway-domain.up.railway.app

# ─── Cloudinary (image & video CDN) ──────────────────────────
# Sign up free at https://cloudinary.com — find these in your dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Admin Setup (optional) ──────────────────────────────────
ADMIN_SETUP_KEY=replace_with_a_secret_key
